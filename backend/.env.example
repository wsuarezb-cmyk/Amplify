# ─────────────────────────────────────────────────────────────
# Pitch — Variables de entorno del backend
# Copiar este archivo a .env y completar con valores reales.
# NUNCA commitear el .env con credenciales reales.
# ─────────────────────────────────────────────────────────────

# ── BigQuery (requeridos, sin defaults) ───────────────────────
BQ_PROJECT_ID=bi-fcom-drmb-sell-in-sbx
BQ_DATASET=sandbox_data_analytics_psc
PLANNER_DATASET=sandbox_data_analytics

# Ruta al archivo de credenciales GCP.
# Pedirle el archivo a Ana Oviedo (aoviedo@falabella.com).
# En desarrollo local: ruta relativa desde la raíz del proyecto o absoluta.
# En Cloud Run: se monta como volumen desde Secret Manager.
BQ_CREDENTIALS_PATH=./credentials/gcp_user_credentials.json

# ── Autenticación ─────────────────────────────────────────────
# En producción NO hay variables de auth: la identidad viene del header de
# IAP (X-Goog-Authenticated-User-Email) y el rol se resuelve contra pitch_users.
#
# ⚠️  SOLO DESARROLLO LOCAL — nunca en producción:
# Sin IAP delante no llega el header. Con DEV_AUTH_BYPASS=true se usa
# DEV_USER_EMAIL como identidad simulada. En Cloud Run estas variables no
# existen → sin header → 401 (fail-closed).
DEV_AUTH_BYPASS=true
DEV_USER_EMAIL=aoviedo@falabella.com

# ── CORS ──────────────────────────────────────────────────────
# Orígenes permitidos, separados por coma si hay varios.
ALLOWED_ORIGINS=http://localhost:5173

# ── Diagnóstico IA (opcional) ─────────────────────────────────
# Sin KAIROS_JWT el diagnóstico responde 503 y el resto de la app funciona
# igual. El JWT es el del proyecto de calidad (secret
# kairos-jwt-saaca-evaluate-job-dev) — NUNCA commitearlo.
KAIROS_JWT=
# Endpoint y modelo son un PAR (el gateway valida que coincidan). Defaults = SAACA.
# KAIROS_CHAT_ENDPOINT=fal-saaca-evaluate-gemini-31-flash-lite-oai
# GENAI_MODEL=gemini-3.1-flash-lite
# Diagnósticos por usuario y mes (ADMIN sin límite; fallidos no cuentan).
# DIAGNOSTICO_CUOTA_MENSUAL=5
